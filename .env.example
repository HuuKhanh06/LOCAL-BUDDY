# =============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG LOCALBUDDY ĐÀ NẴNG (.env.example)
# Sao chép tệp này thành .env (cp .env.example .env) và điền thông tin từ
# Supabase Dashboard -> Project Settings -> API
# LƯU Ý BẢO MẬT:
#   - Chỉ dùng PUBLIC ANON KEY cho trình duyệt (VITE_SUPABASE_ANON_KEY).
#   - TUYỆT ĐỐI KHÔNG đặt SUPABASE_SERVICE_ROLE_KEY vào biến có tiền tố VITE_
#     và KHÔNG BAO GIỜ commit tệp .env lên Git!
# =============================================================================

# URL của Project Supabase (VD: https://abcdefghijklm.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Khóa công khai Anon Key của Supabase (An toàn khi dùng cùng Row Level Security)
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Chế độ nguồn dữ liệu: 'supabase' (khi đã nối Cloud) hoặc 'hybrid' (tự động fallback khi chạy offline)
VITE_DATA_MODE=hybrid

# -----------------------------------------------------------------------------
# BIẾN DÀNH RIÊNG CHO SUPABASE EDGE FUNCTIONS / CLI (KHÔNG CÓ TIỀN TỐ VITE_)
# Chỉ cấu hình trên Supabase Secrets (supabase secrets set ...)
# -----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key-never-commit
# SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
